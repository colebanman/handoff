    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "ai": "^6.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "motion": "^13.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.12",
    "@types/node": "^26.5.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.0",
