{
  "name": "handoff",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Handoff \u2014 an AI browser extension for handing off work in your browser.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "build:dev": "node scripts/build-dev.mjs",
    "test": "vitest run",
    "bridge": "node bridge/handoff-bridge.mjs start",
    "test:chatgpt-auth": "node scripts/verify-chatgpt-auth.mjs",
    "typecheck": "tsc --noEmit",
    "audit:public": "node scripts/audit-public.mjs",
    "test:ui": "node scripts/ui-stress/run.mjs",
    "typecheck:ui": "tsc --noEmit -p scripts/ui-stress/tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.127",
    "@ai-sdk/cerebras": "^2.0.81",
    "@ai-sdk/gateway": "^2.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "@ai-sdk/xai": "^3.0.103",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.3.0",
    "ai": "^6.0.0",
    "gpt-tokenizer": "^4.0.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "motion": "^13.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remend": "^1.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.12",
    "@types/node": "^26.5.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "micromark-extension-math": "^3.1.0",
    "micromark-util-types": "^2.0.3",
    "react-select": "^5.10.2",
    "remark-parse": "^11.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
